<resources>
    <string name="app_name">BiBi 輸入法橋接</string>
    <string name="xposed_description">透過被 Hook 的輸入法，將說點啥懸浮球辨識結果與可選的輸入欄位上下文經 InputConnection 橋接回填。</string>
    <string name="bridge_visual_title">橋接模块設定</string>
    <string name="bridge_visual_summary">調整被 Hook 輸入法使用的底部觸摸區域。在 LSPosed/LSPatch 中修改會盡力生效；若 Hook 程序無法讀取設定，將安全回退到預設值。</string>
    <string name="bridge_visual_preview_title">預覽</string>
