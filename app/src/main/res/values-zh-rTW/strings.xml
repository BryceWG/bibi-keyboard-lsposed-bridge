    <string name="bridge_host_target_title">連線目標</string>
    <string name="bridge_host_target_summary">選擇模組要連線說點啥的哪個版本。</string>
    <string name="bridge_host_target_auto">自動（優先 Pro）</string>
    <string name="bridge_host_target_pro">說點啥 Pro</string>
    <string name="bridge_host_target_open_source">說點啥開源版</string>
    <string name="bridge_host_target_change">變更連線目標</string>
    <string name="feature_bridge_host_target_off_desc">手動目標不會回退。若所選版本不可用，PCM 與剪貼簿橋接請求會失敗。</string>
    <string name="feature_bridge_host_target_on_desc">自動模式優先連線說點啥 Pro，失敗後回退開源版；手動選擇 Pro 或開源版時不回退。</string>
    <string name="bridge_show_recording_area_title">顯示觸摸區域</string>
    <string name="bridge_show_recording_area_summary">在被 Hook 的輸入法底部注入波形與觸摸區域，可用於錄音或跳轉到其他輸入法。</string>
    <string name="feature_bridge_show_recording_area_off_desc">不再注入波形與觸摸區域；文字插入、視窗可見性與剪貼簿橋接仍可用。</string>
    <string name="feature_bridge_show_recording_area_on_desc">在被 Hook 的輸入法底部顯示觸摸區域。可用於錄音，或改為長按跳轉輸入法。變更最多在下一次輸入法視窗顯示時生效。</string>
    <string name="bridge_recording_only_waveform_title">僅錄音時顯示波形</string>
    <string name="bridge_recording_only_waveform_summary">隱藏閒置波形，但保留觸摸區域。</string>
    <string name="feature_bridge_recording_only_waveform_off_desc">閒置和錄音時均顯示波形。</string>
    <string name="feature_bridge_recording_only_waveform_on_desc">閒置時隱藏波形，觸摸區域仍可用，錄音時顯示動態波形。變更最多在下一次輸入法視窗顯示時生效。</string>
    <string name="bridge_tap_to_toggle_recording_title">點按啟停錄音</string>
    <string name="bridge_tap_to_toggle_recording_summary">點按兩次控制錄音，無需持續按住觸摸區域。</string>
    <string name="feature_bridge_tap_to_toggle_recording_off_desc">長按觸摸區域開始錄音，放開結束；移出區域會取消錄音。</string>
    <string name="feature_bridge_tap_to_toggle_recording_on_desc">點按一次開始錄音，再次點按結束。變更最多在下一次輸入法視窗顯示時生效。</string>
    <string name="bridge_long_press_switch_ime_title">長按跳轉到其他輸入法</string>
    <string name="bridge_long_press_switch_ime_summary">長按觸摸區域後切換到指定輸入法，此時該區域不再用於錄音。</string>
    <string name="feature_bridge_long_press_switch_ime_off_desc">觸摸區域繼續用於開始和結束錄音。</string>
    <string name="feature_bridge_long_press_switch_ime_on_desc">長按觸摸區域會切換到所選輸入法，不再開始錄音；點按啟停錄音在此模式下不可用。目標輸入法必須已在系統設定中啟用。變更最多在下一次輸入法視窗顯示時生效。</string>
    <string name="bridge_switch_ime_target_title">其他輸入法</string>
    <string name="bridge_switch_ime_target_summary">選擇長按後要切換到的輸入法。</string>
    <string name="bridge_switch_ime_target_none">請選擇輸入法</string>
    <string name="bridge_toast_ime_not_selected">請先在橋接設定中選擇要跳轉的輸入法</string>
    <string name="bridge_toast_ime_switch_failed">無法切換輸入法。請確認目標輸入法已在系統設定中啟用後重試</string>
    <string name="bridge_hide_idle_waveform_ime_switch_title">常態隱藏波形</string>
    <string name="bridge_hide_idle_waveform_ime_switch_summary">隱藏閒置波形，不顯示觸摸區域外觀；仍可長按跳轉輸入法。</string>
    <string name="feature_bridge_hide_idle_waveform_ime_switch_off_desc">跳轉輸入法模式下仍顯示閒置波形，便於找到觸摸區域。</string>
    <string name="feature_bridge_hide_idle_waveform_ime_switch_on_desc">不顯示波形和觸摸區域外觀，區域仍可長按以跳轉輸入法。此開關與「僅錄音時顯示波形」相互獨立。變更最多在下一次輸入法視窗顯示時生效。</string>
</resources>
