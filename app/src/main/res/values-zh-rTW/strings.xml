    <string name="bridge_visual_width_value">觸發區寬度：%1$d dp</string>
    <string name="bridge_visual_height_value">觸發區高度：%1$d dp（同時會將條帶從底邊上移）</string>
    <string name="bridge_visual_width_label">寬度</string>
    <string name="bridge_visual_height_label">高度</string>
    <string name="bridge_visual_dp_value">%1$d dp</string>
    <string name="bridge_visual_height_hint">同時會將條帶從底邊上移</string>
    <string name="bridge_visual_trigger_delay_label">觸發延遲</string>
    <string name="bridge_visual_trigger_delay_value">%1$d 毫秒</string>
    <string name="bridge_visual_trigger_delay_hint">設為 0 毫秒時立即觸發；大於 0 時，短按會透傳給輸入法，停留達到此時長後才觸發觸摸區域動作（錄音或跳轉輸入法）並攔截按鍵。</string>
